{
  "name": "planner-workspace",
  "productName": "Planner",
  "version": "0.1.0",
  "description": "A local Mac calendar and rich task workspace",
  "author": "Planner contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "start": "npm run build && electron .",
    "build": "vite build && node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && node scripts/prepare-runtime.mjs && electron-forge package",
    "make": "npm run build && node scripts/prepare-runtime.mjs && electron-forge make",
    "test:desktop": "npm run build && node scripts/prepare-runtime.mjs && node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "@azure/msal-node": "7.0.1",
    "@blocknote/core": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@radix-ui/react-icons": "1.3.2",
    "better-sqlite3": "13.0.3",
    "jose": "6.2.12",
    "katex": "0.19.0",
    "luxon": "3.7.2",
    "mammoth": "1.13.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-dmg": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/katex": "0.16.8",
    "@types/luxon": "3.7.6",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.6.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {"node": ">=24.0.0"}
}
